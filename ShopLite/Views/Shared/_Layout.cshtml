<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ShopLite</title>
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/shoplite.css")" rel="stylesheet" />
</head>
<body>
    @Html.Partial("_Header")
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">&copy; @DateTime.Now.Year ShopLite - Mua sắm công nghệ dễ dàng.</div>
    </footer>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
