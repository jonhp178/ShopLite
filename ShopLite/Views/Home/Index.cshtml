@model IEnumerable<ShopLite.Models.Product>

@{
    ViewBag.Title = "Trang chủ";
    var heroProduct = Model.FirstOrDefault();
}

@functions {
    public string ResolveImageUrl(string imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return Url.Content("~/Content/images/placeholder.png");
        }

        imagePath = imagePath.Trim().Replace("\\", "/");

        if (imagePath.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || imagePath.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
            || imagePath.StartsWith("data:", System.StringComparison.OrdinalIgnoreCase))
        {
            return imagePath;
        }

        imagePath = imagePath.TrimStart('~', '/');

        if (imagePath.StartsWith("Content/", System.StringComparison.OrdinalIgnoreCase))
        {
            return Url.Content("~/" + imagePath);
        }

        if (imagePath.StartsWith("images/", System.StringComparison.OrdinalIgnoreCase))
        {
            imagePath = imagePath.Substring("images/".Length);
        }

        return Url.Content("~/Content/images/" + imagePath);
    }
}

<div class="container home-page">
    <section class="hero-banner">
        <div class="hero-banner__content">
            <span class="hero-banner__eyebrow">SHOPLITE · CÔNG NGHỆ CHÍNH HÃNG</span>
            <h1>Sản phẩm chất lượng<br />Giá tốt mỗi ngày</h1>
            <p>Khám phá các sản phẩm đa dạng, chọn món bạn yêu thích và mua sắm thật dễ dàng.</p>
            <a class="btn btn-primary hero-banner__button" href="#products">Khám phá ngay <span aria-hidden="true">→</span></a>
        </div>
        @*@if (heroProduct != null && !string.IsNullOrWhiteSpace(heroProduct.ImageUrl))
        {
            <div class="hero-banner__image-wrap">
                <img src="@ResolveImageUrl(heroProduct.ImageUrl)" alt="@heroProduct.ProductName" class="hero-banner__image" />
            </div>
        }*@
    </section>

    <section class="product-section" id="products">
        <div class="section-heading">
            <div>
                <span class="section-heading__eyebrow">SHOPLITE GỢI Ý</span>
                <h2>Sản phẩm nổi bật</h2>
            </div>
            <span class="section-heading__note">@Model.Count() sản phẩm</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h3>Chưa tìm thấy sản phẩm</h3>
                <p>Thử từ khóa khác hoặc chọn một danh mục khác nhé.</p>
                <a class="btn btn-outline-primary" href="@Url.Action("Index", "Home")">Xem tất cả sản phẩm</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var product in Model)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <article class="product-card">
                            <a class="product-card__image-link" href="#" aria-label="@product.ProductName">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@ResolveImageUrl(product.ImageUrl)" alt="@product.ProductName" class="product-card__image" loading="lazy" />
                                }
                                else
                                {
                                    <div class="product-card__placeholder">SHOPLITE</div>
                                }
                            </a>
                            @if (product.Category != null)
                            {
                                <span class="product-card__category">@product.Category.CategoryName</span>
                            }
                            <h3 class="product-card__name">@product.ProductName</h3>
                            <div class="product-card__bottom">
                                <span class="product-card__price">@product.Price.ToString("N0") đ</span>
                                <a href="#" class="product-card__add" aria-label="Thêm @product.ProductName vào giỏ hàng">+</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</div>
